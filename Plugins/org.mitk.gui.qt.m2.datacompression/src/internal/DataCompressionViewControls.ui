<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DataCompressionViewControls</class>
 <widget class="QWidget" name="DataCompressionViewControls">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>566</width>
    <height>720</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Data Compression</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QmitkMultiNodeSelectionWidget" name="imageSelection" native="true"/>
   </item>
   <item>
    <widget class="QmitkSingleNodeSelectionWidget" name="peakListSelection" native="true"/>
   </item>
   <item>
    <widget class="QmitkMultiNodeSelectionWidget" name="maskSelection" native="true"/>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_maskLabel">
     <item>
      <widget class="QLabel" name="label_maskLabel">
       <property name="text">
        <string>Label</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="boxMaskLabelValue">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="toolTip">
        <string>Only pixels of the chosen label value are used. The list contains the unique label values of the selected masks, the number in brackets is the number of selected masks containing this label value.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QCheckBox" name="checkPublishLoadings">
     <property name="toolTip">
      <string>Attaches one value per centroid and component to the selected peak list, so that the feature list view can show what every centroid contributes to every component of every run side by side. Only methods that express their components over the peaks have loadings; t-SNE and k-means do not.</string>
     </property>
     <property name="text">
      <string>Attach component loadings to the peak list</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QTabWidget" name="TabWidget">
     <property name="enabled">
      <bool>true</bool>
     </property>
     <property name="currentIndex">
      <number>2</number>
     </property>
     <widget class="QWidget" name="tabPCA">
      <attribute name="title">
       <string>PCA</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <item>
        <widget class="QLabel" name="label_12">
         <property name="text">
          <string>For each image apply a PCA using the selected list of centroids.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_7">
         <item>
          <widget class="QLabel" name="label_7">
           <property name="text">
            <string>Components</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QSpinBox" name="pca_dims">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>99999</number>
           </property>
           <property name="value">
            <number>15</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunPCA">
         <property name="text">
          <string>Get PCA</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_4">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabTSNE">
      <attribute name="title">
       <string>t-SNE</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <layout class="QGridLayout" name="tSNE">
         <item row="1" column="0">
          <widget class="QLabel" name="label_9">
           <property name="text">
            <string>Perplexity</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="tsne_perplexity">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="value">
            <number>5</number>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="tsne_theta">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
                     <property name="decimals">
                        <number>8</number>
                     </property>
           <property name="value">
            <double>0.500000000000000</double>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="label_11">
           <property name="toolTip">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Shrink the input images by a constant factor in x and y direction for t-SNE calculation. The computation time is reduced by lowering the resolution.&lt;/p&gt;&lt;p&gt;The dimensionality reduced image is upsampled to original input dimensions.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="text">
            <string>Shrink factor</string>
           </property>
          </widget>
         </item>
         <item row="0" column="0">
          <widget class="QLabel" name="label_8">
           <property name="text">
            <string>Iterations</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="tnse_iters">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="maximum">
            <number>99999</number>
           </property>
           <property name="value">
            <number>200</number>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_10">
           <property name="text">
            <string>Theta</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="tsne_shrink">
           <property name="sizePolicy">
            <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="toolTip">
            <string>Higher values will result in lower resolution images.</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>10</number>
           </property>
           <property name="value">
            <number>1</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunTSNE">
         <property name="text">
          <string>Get t-SNE (RGB-Image)</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_6">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab">
      <attribute name="title">
       <string>K-Means</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_4">
       <item>
        <widget class="QLabel" name="label_13">
         <property name="text">
          <string>Apply K-Means to the data of all selected images. Result Masks can be edited manually using the segmentation tools.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QComboBox" name="boxKMeansVariant"/>
       </item>
       <item>
        <widget class="QComboBox" name="boxKMeansDistanceMetric"/>
       </item>
       <item>
        <widget class="QSlider" name="spatialWeight">
         <property name="maximum">
          <number>10</number>
         </property>
         <property name="value">
          <number>1</number>
         </property>
         <property name="orientation">
          <enum>Qt::Orientation::Horizontal</enum>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_8">
         <item>
          <widget class="QLabel" name="label_14">
           <property name="text">
            <string>Clusters</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QSpinBox" name="kmeans_clusters">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>99999</number>
           </property>
           <property name="value">
            <number>4</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunKMeans">
         <property name="text">
          <string>Get K-Means</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabNMF">
      <attribute name="title">
       <string>NMF</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_tabNMF">
       <item>
        <widget class="QLabel" name="label_tabNMF">
         <property name="text">
          <string>Factorize the data of each selected image into non-negative components. Unlike PCA the components add up instead of cancelling out, so each of them reads as a spectral signature with its own distribution over the image.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridNMF">
         <item row="0" column="0">
          <widget class="QLabel" name="label_nmf_components">
           <property name="text">
            <string>Components</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="nmf_components">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>50</number>
           </property>
           <property name="value">
            <number>5</number>
           </property>
           <property name="toolTip">
            <string>Number of non-negative components to factorize the data into.</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_nmf_iterations">
           <property name="text">
            <string>Iterations</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="nmf_iterations">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>10000</number>
           </property>
           <property name="value">
            <number>200</number>
           </property>
           <property name="toolTip">
            <string>Upper bound on the multiplicative update steps.</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_nmf_tolerance">
           <property name="text">
            <string>Tolerance</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="nmf_tolerance">
           <property name="decimals">
            <number>6</number>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.000100000000000</double>
           </property>
           <property name="value">
            <double>0.000100000000000</double>
           </property>
           <property name="toolTip">
            <string>The factorization stops early once the residual improves by less than this.</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunNMF">
         <property name="text">
          <string>Get NMF</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_nmf">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabICA">
      <attribute name="title">
       <string>ICA</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_tabICA">
       <item>
        <widget class="QLabel" name="label_tabICA">
         <property name="text">
          <string>Separate the data of each selected image into statistically independent components. Where PCA looks for the directions of largest variance, ICA looks for the ones that are least Gaussian, which separates signals that overlap in the image. The components come out unordered.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridICA">
         <item row="0" column="0">
          <widget class="QLabel" name="label_ica_components">
           <property name="text">
            <string>Components</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="ica_components">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>50</number>
           </property>
           <property name="value">
            <number>3</number>
           </property>
           <property name="toolTip">
            <string>Number of independent components; this also sets how much variance the whitening keeps.</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_ica_iterations">
           <property name="text">
            <string>Iterations</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="ica_iterations">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>10000</number>
           </property>
           <property name="value">
            <number>200</number>
           </property>
           <property name="toolTip">
            <string>Upper bound on the fixed point steps.</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_ica_tolerance">
           <property name="text">
            <string>Tolerance</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="ica_tolerance">
           <property name="decimals">
            <number>6</number>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.000100000000000</double>
           </property>
           <property name="value">
            <double>0.000100000000000</double>
           </property>
           <property name="toolTip">
            <string>The iteration stops once no component turns by more than this.</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunICA">
         <property name="text">
          <string>Get ICA</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_ica">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabPLSDA">
      <attribute name="title">
       <string>PLS-DA</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_tabPLSDA">
       <item>
        <widget class="QLabel" name="label_tabPLSDA">
         <property name="text">
          <string>Find the peaks that tell the labelled regions apart. Unlike the other methods this one is supervised: every label value of the selected mask is a class, the label value 0 is background, and at least two classes are needed. The component loadings are the ranked answer to which peaks separate the classes.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridPLSDA">
         <item row="0" column="0">
          <widget class="QLabel" name="label_plsda_components">
           <property name="text">
            <string>Components</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QSpinBox" name="plsda_components">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>50</number>
           </property>
           <property name="value">
            <number>3</number>
           </property>
           <property name="toolTip">
            <string>Number of components that separate the classes. Rarely more than a few are useful.</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0" colspan="2">
          <widget class="QCheckBox" name="plsda_autoscale">
           <property name="checked">
            <bool>true</bool>
           </property>
           <property name="toolTip">
            <string>Divides every peak by its standard deviation, so that a weak peak can separate the classes as well as a strong one. Switching it off lets the intensity of a peak decide how much it can contribute.</string>
           </property>
           <property name="text">
            <string>Auto-scale peaks to unit variance</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QCommandLinkButton" name="btnRunPLSDA">
         <property name="text">
          <string>Get PLS-DA</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer_plsda">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="horizontalLayout_progress">
     <item>
      <widget class="QLabel" name="labelMethodStatus">
       <property name="text">
        <string/>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnCancelMethod">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>Stops the running method; the result computed so far is discarded.</string>
       </property>
       <property name="text">
        <string>Cancel</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QCommandLinkButton" name="btnSaveDataCompressionResults">
     <property name="text">
      <string>On save data compression image(s) as NRRD</string>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
 <customwidgets>
  <customwidget>
   <class>QmitkSingleNodeSelectionWidget</class>
   <extends>QWidget</extends>
   <header location="global">QmitkSingleNodeSelectionWidget.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>QmitkMultiNodeSelectionWidget</class>
   <extends>QWidget</extends>
   <header>QmitkMultiNodeSelectionWidget.h</header>
   <container>1</container>
  </customwidget>
